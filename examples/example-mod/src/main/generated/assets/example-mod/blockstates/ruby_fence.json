{
  "multipart": [
    {
      "apply": {
        "model": "example-mod:block/ruby_fence_post"
      }
    },
    {
      "apply": {
        "model": "example-mod:block/ruby_fence_side",
        "uvlock": true
      },
      "when": { "north": "true" }
    },
    {
      "apply": {
        "model": "example-mod:block/ruby_fence_side",
        "y": 90,
        "uvlock": true
      },
      "when": { "east": "true" }
    },
    {
      "apply": {
        "model": "example-mod:block/ruby_fence_side",
        "y": 180,
        "uvlock": true
      },
      "when": { "south": "true" }
    },
    {
      "apply": {
        "model": "example-mod:block/ruby_fence_side",
        "y": 270,
        "uvlock": true
      },
      "when": { "west": "true" }
    }
  ]
}
